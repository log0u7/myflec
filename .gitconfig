[user]
	name = Anne Haunyme
	email = anne.haunyme@public.mail

[includeIf "gitdir:~/projets/work/"]
	path = ~/.gitconfig.d/work
[includeIf "gitdir:~/projets/github/"]
	path = ~/.gitconfig.d/github
[includeIf "gitdir:~/projets/gitlab/"]
	path = ~/.gitconfig.d/gitlab
[includeIf "gitdir:~/projets/company/"]
	path = ~/.gitconfig.d/company
[includeIf "hasconfig:remote.*.url:git@gitlab.com:your-username/*"]
	path = ~/.gitconfig.d/gitlab
[includeIf "hasconfig:remote.*.url:git@github.com:your-username/*"]
	path = ~/.gitconfig.d/github

[include]
	path = ~/.gitconfig.d/config
	path = ~/.gitconfig.d/colors
	path = ~/.gitconfig.d/aliases
