# Public git forges: SSH over 443 (main route)
# vi: ft=sshconfig
#
# Port 22 is hard-blocked on some networks. These blocks override the
# HostName/Port of the forge blocks in ~/.ssh/config: config.d/* is
# included first and SSH keeps the first value seen per option, so the
# User git / IdentityFile from the main config still apply.
#
# Official endpoints, host fingerprints verified against known_hosts:
#   ssh.github.com:443     SHA256:+DiY3wvvV6TuJJhbpZisF/zLDA0zPMSvHdkr4UvCOqU
#   altssh.gitlab.com:443  SHA256:eUXGGm1YGsMAS7vkcx6JOJdOGHPem5gQp4taiCfCLB8
#
# notabug.org has no SSH-over-443 (443 is its web server only): it stays
# on port 22 and is reachable only from networks where port 22 passes.

Host github.com github.com-work
    HostName ssh.github.com
    Port 443

Host gitlab.com gitlab.com-work
    HostName altssh.gitlab.com
    Port 443
